{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local preferences, user-confirmed links, rule downloads and sidebar positioning",
  "windows": ["main"],
  "permissions": [
    "core:default", "store:default", "opener:default", "dialog:allow-save", "dialog:allow-confirm", "fs:allow-write-text-file",
    "fs:allow-read-text-file", "fs:allow-exists", "fs:allow-mkdir", "fs:allow-rename",
    { "identifier": "fs:scope", "allow": [{ "path": "$APPCONFIG" }, { "path": "$APPCONFIG/rules-cache.json" }, { "path": "$APPCONFIG/rules-cache.pending.json" }] },
    { "identifier": "http:default", "allow": [{ "url": "https://**" }] },
    "core:window:allow-set-position", "core:window:allow-set-size", "core:window:allow-set-min-size",
    "core:window:allow-set-always-on-top", "core:window:allow-set-theme"
  ]
}
