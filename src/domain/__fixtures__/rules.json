{
  "format": "academic-search-rules",
  "schemaVersion": 1,
  "revision": 2,
  "sites": [
    {
      "id": "pubmed",
      "name": "PubMed",
      "homepage": "https://pubmed.ncbi.nlm.nih.gov/",
      "category": "生物医学",
      "notes": "由 NCBI 提供。检索词及排序参数依据官方帮助文档；不读取或抓取检索结果。",
      "searchRules": [
        {
          "id": "articles",
          "name": "文献检索",
          "mode": "query",
          "baseUrl": "https://pubmed.ncbi.nlm.nih.gov/",
          "fixedParams": [],
          "fields": [
            {
              "id": "keyword",
              "label": "关键词",
              "param": "term",
              "type": "text",
              "required": true,
              "defaultValue": "",
              "placeholder": "输入关键词或完整检索式"
            },
            {
              "id": "sort",
              "label": "排序方式",
              "param": "sort",
              "type": "select",
              "required": false,
              "defaultValue": "relevance",
              "options": [
                {
                  "label": "相关性优先",
                  "value": "relevance"
                },
                {
                  "label": "最新发表",
                  "value": "pubdate"
                },
                {
                  "label": "最新收录",
                  "value": "date"
                }
              ]
            }
          ],
          "verification": {
            "status": "verified",
            "checkedAt": "2026-10-17",
            "method": "official-docs",
            "referenceUrl": "https://pubmed.ncbi.nlm.nih.gov/help/#get-a-permalink-to-bookmark-or-share-your-search",
            "notes": "官方说明支持 term、sort 查询参数；复杂表达式由用户完整输入。"
          }
        },
        {
          "id": "expression",
          "name": "完整检索式",
          "mode": "query",
          "baseUrl": "https://pubmed.ncbi.nlm.nih.gov/",
          "fixedParams": [],
          "fields": [
            {
              "id": "expression",
              "label": "PubMed 检索式",
              "param": "term",
              "type": "text",
              "required": true,
              "defaultValue": "",
              "placeholder": "手动输入，例如 asthma AND review[pt]"
            }
          ],
          "verification": {
            "status": "verified",
            "checkedAt": "2026-10-17",
            "method": "official-docs",
            "referenceUrl": "https://pubmed.ncbi.nlm.nih.gov/help/#get-a-permalink-to-bookmark-or-share-your-search",
            "notes": "将用户手动编写的完整表达式作为 term 提交，不自动组合条件。"
          }
        }
      ]
